# LLM Configuration
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Demo Mode (set to true to run without LLM API key)
DEMO_MODE=true

# Database
DATABASE_URL=sqlite+aiosqlite:///./twinmind.db

# Application
APP_NAME=TwinMind AI
APP_VERSION=1.0.0
DEBUG=true

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
